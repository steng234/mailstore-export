# MailStore Export — environment variables
# Copy this file to `.env` (same folder) and fill in your values.
# The scripts load it at startup; CLI flags always take precedence.
# NEVER commit your real .env — it is git-ignored.

# --- Connection ---
MAILSTORE_HOST=127.0.0.1
MAILSTORE_PORT=8462

# --- Credentials ---
MAILSTORE_USER=admin
MAILSTORE_PASSWORD=
MAILSTORE_WORKERS=32

# --- (optional) Output folder ---
# MAILSTORE_OUTPUT=/Volumes/Backup/eml_export

# --- (optional) Archives to export, comma-separated ---
# If set, skips the interactive picker. Leave empty to choose at runtime.
# MAILSTORE_ARCHIVES=archive1,archive2

# --- (alternative) Static bearer token instead of user/password ---
# Expires in ~5 minutes, use only for quick tests.
# MAILSTORE_TOKEN=
